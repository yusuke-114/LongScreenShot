    },
    "Add Command, Option, Control, or Shift to the shortcut." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットにCommand、Option、Control、Shiftのいずれかを含めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키에 Command, Option, Control 또는 Shift를 추가하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在快捷键中加入 Command、Option、Control 或 Shift。"
