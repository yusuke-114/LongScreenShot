    "Choose a folder once to allow automatic exports there." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度フォルダを選択すると、以降はそこへ自動で書き出されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더를 한 번 선택하면 이후 그곳으로 자동 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需选择一次文件夹，之后截图会自动保存到那里。"
          }
        }
      }
    },
    "Choose a save folder to allow Long Screenshot to export the scrolling screenshot." : {
