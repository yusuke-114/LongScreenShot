    },
    "Set a global shortcut, select a scrollable area in any app, then scroll downward to create one seamless image." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グローバルショートカットを設定し、任意のアプリでスクロールできる領域を選択して下へスクロールすると、継ぎ目のない1枚の画像が作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전역 단축키를 설정하고 아무 앱에서나 스크롤 가능한 영역을 선택한 뒤 아래로 스크롤하면 이음새 없는 한 장의 이미지가 만들어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置一个全局快捷键，在任意 App 中框选可滚动的区域，然后向下滚动，即可生成一张无缝拼接的长图。"
          }
